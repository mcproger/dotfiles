{
  "edit_predictions": {
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null
    },
    "enabled_in_text_threads": false
  },
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "openai",
      "model": "gpt-5"
    },
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-3-7-sonnet"
    }
  },
  "active_pane_modifiers": {
    "border_size": 0.2,
    "inactive_opacity": 1.0
  },
  "auto_install_extensions": {
    "docker-compose": true,
    "dockerfile": true,
    "html": true,
    "pylsp": true,
    "toml": true,
    "zig": true,
    "sql": true,
    "make": true,
    "java": true
  },
  "auto_signature_help": true,
  "autosave": "on_focus_change",
  "autoscroll_on_clicks": true,
  "buffer_font_family": "FiraMono Nerd Font Mono",
  "buffer_font_size": 16,
  "buffer_font_weight": 400,
  "buffer_line_height": "comfortable",
  "collaboration_panel": {
    "button": false
  },
  "context_servers": {
    "mcp-server-github": {
      "settings": {
        "github_personal_access_token": ""
      },
      "source": "extension"
    }
  },
  "current_line_highlight": "none",
  "cursor_blink": false,
  "features": {
    "edit_prediction_provider": "zed"
  },
  "file_scan_exclusions": [
    "**/*_cache",
    "**/.*-version",
    "**/.DS_Store",
    "**/.git",
    "**/.rope*",
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "**/build",
    "**/dist",
    "**/node_modules",
    "**/target"
  ],
  "gutter": {
    "line_numbers": false
  },
  "icon_theme": "Material Icon Theme",
  "indent_guides": {
    "coloring": "indent_aware",
    "enabled": true
  },
  "inlay_hints": {
    "enabled": true
  },
  "languages": {
    "Python": {
      "show_edit_predictions": true,
      "format_on_save": "on",
      "formatter": [
        {
          "code_actions": {
            "source.fixAll.ruff": true,
            "source.organizeImports.ruff": true
          }
        },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ],
      "language_servers": ["pyright", "ruff"]
    },
    "Zig": {
      "show_edit_predictions": false
    }
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python": {
          "pythonPath": "venv/bin/python"
        },
        "python.analysis": {
          "diagnosticMode": "workspace"
        }
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 120,
          "lint": {
            "extendSelect": ["I"]
          }
        }
      }
    }
  },
  "preferred_line_length": 120,
  "project_panel": {
    "button": false,
    "indent_size": 25
  },
  "restore_on_startup": "none",
  "scrollbar": {
    "show": "never"
  },
  "soft_wrap": "editor_width",
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "tabs": {
    "file_icons": false,
    "git_status": false,
    "show_close_button": "hover"
  },
  "toolbar": {
    "quick_actions": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "button": false,
    "detect_venv": {
      "on": {
        "activate_script": "fish"
      }
    },
    "dock": "bottom",
    "env": {
      "EDITOR": "zed --wait"
    }
  },
  "theme": "Catppuccin Frappé",
  "ui_font_family": "Zed Plex Sans",
  "ui_font_size": 14,
  "vim_mode": true
}
